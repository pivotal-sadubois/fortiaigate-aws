# ------------------------------------------------------------------------------------------
# Function Name ......: testAppDNS
# Function Purpose ...: Test DNS and HTTP/HTTPS access for an application
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: <fqdn>
# ------------------------------------------------------------------------------------------
testAppDNS() {

  APP_FQDN="$1"

  echo " ▪ Test Appliication ...: https://$APP_FQDN"

  if [ -z "$APP_FQDN" ]; then
    echo "ERROR: Missing arguments"
    echo "       => testAppDNS <fqdn>"
    exit 1
  fi

  echo " ▪ Waiting for public DNS propagation..."
  n=0
  while [ $n -lt 30 ]; do
    nslookup "$APP_FQDN" 8.8.8.8 >/tmp/error.log 2>&1; ret=$?
    if [ $ret -eq 0 ]; then
      break
    fi
    sleep 10
    let n=n+1
  done

  while [ $n -lt 30 ]; do
    nslookup "$APP_FQDN" >/tmp/error.log 2>&1; ret=$?
    if [ $ret -eq 0 ]; then
      break
    fi
    sleep 10
    let n=n+1 
  done

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: DNS record not yet resolvable via public DNS"
    echo "       => nslookup $APP_FQDN 8.8.8.8"
    exit 1
  fi

  echo " ▪ HTTP Test ...........: http://$APP_FQDN (succeeded)"
  curl -I --max-time 10 "http://$APP_FQDN" > /tmp/error.log 2>/dev/null; ret=$?
  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: HTTP test failed"
    echo "       => curl -I --max-time 10 http://$APP_FQDN"
    exit 1
  fi

  echo " ▪ HTTPS Test ..........: https://$APP_FQDN (succeeded)"
  curl -I --max-time 10 "https://$APP_FQDN" > /tmp/error.log 2>/dev/null; ret=$?
  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: HTTPS test failed"
    echo "       => curl -I --max-time 10 https://$APP_FQDN"
    exit 1
  fi
}

# ------------------------------------------------------------------------------------------
# Function Name ......: deleteEFSstorage
# Function Purpose ...: Delete EFS Storage
# ------------------------------------------------------------------------------------------
# Argument ($1) ......:
# Dependancies: ......: AWS_REGION, EKS_CLUSTER_NAME
# ------------------------------------------------------------------------------------------
# Return Value .......:
# ------------------------------------------------------------------------------------------
deleteEFSstorage() {

  EFS_NAME="efs-$EKS_CLUSTER_NAME"

  echo " ▪ checking Amazon EFS resources"

  EFS_FILE_SYSTEM_IDS=$(aws efs describe-file-systems \
    --profile "$AWS_PROFILE" \
    --region "$EKS_REGION" \
    --query "FileSystems[?Name=='$EFS_NAME'].FileSystemId" \
    --output text 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to list Amazon EFS filesystems"
    return 1
  fi

  if [ -z "$EFS_FILE_SYSTEM_IDS" ] || [ "$EFS_FILE_SYSTEM_IDS" = "None" ]; then
    echo " ▪ Amazon EFS already deleted"
    return 0
  fi

  if [ "$(echo "$EFS_FILE_SYSTEM_IDS" | wc -w | tr -d ' ')" -ne 1 ]; then
    echo "ERROR: Multiple EFS filesystems named $EFS_NAME found"
    echo "       $EFS_FILE_SYSTEM_IDS"
    return 1
  fi

  EFS_FILE_SYSTEM_ID="$EFS_FILE_SYSTEM_IDS"

  echo " ▪ deleting Amazon EFS FileSystem ($EFS_FILE_SYSTEM_ID)"

  EFS_ACCESS_POINTS=$(aws efs describe-access-points \
    --file-system-id "$EFS_FILE_SYSTEM_ID" \
    --profile "$AWS_PROFILE" \
    --region "$EKS_REGION" \
    --query 'AccessPoints[].AccessPointId' \
    --output text 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to list EFS Access Points"
    return 1
  fi

  for ap in $EFS_ACCESS_POINTS; do

    echo "   ▪ delete EFS Access Point ($ap)"

    aws efs delete-access-point \
      --access-point-id "$ap" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" > /tmp/error.log 2>&1
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to delete EFS Access Point ($ap)"
      return 1
    fi
  done

  echo " ▪ Waiting for EFS Access Points deletion..."

  for i in {1..60}; do

    EFS_ACCESS_POINTS=$(aws efs describe-access-points \
      --file-system-id "$EFS_FILE_SYSTEM_ID" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --query 'AccessPoints[].AccessPointId' \
      --output text 2>/tmp/error.log)
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to check EFS Access Points"
      return 1
    fi

    [ -z "$EFS_ACCESS_POINTS" ] && break

    sleep 10
  done

  if [ -n "$EFS_ACCESS_POINTS" ]; then
    echo "ERROR: Timed out waiting for EFS Access Points deletion"
    return 1
  fi

  EFS_MOUNT_TARGETS=$(aws efs describe-mount-targets \
    --file-system-id "$EFS_FILE_SYSTEM_ID" \
    --profile "$AWS_PROFILE" \
    --region "$EKS_REGION" \
    --query 'MountTargets[].MountTargetId' \
    --output text 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to list EFS Mount Targets"
    return 1
  fi

  for mt in $EFS_MOUNT_TARGETS; do

    echo "   ▪ delete EFS Mount Target ($mt)"

    aws efs delete-mount-target \
      --mount-target-id "$mt" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" > /tmp/error.log 2>&1
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to delete EFS Mount Target ($mt)"
      return 1
    fi
  done

  echo " ▪ Waiting for EFS Mount Targets deletion..."

  for i in {1..60}; do

    EFS_MOUNT_TARGETS=$(aws efs describe-mount-targets \
      --file-system-id "$EFS_FILE_SYSTEM_ID" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --query 'MountTargets[].MountTargetId' \
      --output text 2>/tmp/error.log)
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to check EFS Mount Targets"
      return 1
    fi

    [ -z "$EFS_MOUNT_TARGETS" ] && break

    sleep 10
  done

  if [ -n "$EFS_MOUNT_TARGETS" ]; then
    echo "ERROR: Timed out waiting for EFS Mount Targets deletion"
    return 1
  fi

  echo " ▪ Deleting EFS FileSystem ($EFS_FILE_SYSTEM_ID)"

  aws efs delete-file-system \
    --file-system-id "$EFS_FILE_SYSTEM_ID" \
    --profile "$AWS_PROFILE" \
    --region "$EKS_REGION" > /tmp/error.log 2>&1
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to delete EFS FileSystem ($EFS_FILE_SYSTEM_ID)"
    return 1
  fi

  echo " ▪ Waiting for EFS FileSystem deletion..."

  for i in {1..60}; do

    EFS_STATUS=$(aws efs describe-file-systems \
      --file-system-id "$EFS_FILE_SYSTEM_ID" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --query 'FileSystems[0].LifeCycleState' \
      --output text 2>/tmp/error.log)
    ret=$?

    if [ $ret -ne 0 ]; then
      if grep -q 'FileSystemNotFound' /tmp/error.log; then
        echo " ▪ Amazon EFS successfully deleted"
        return 0
      fi

      logMessages /tmp/error.log
      echo "ERROR: Failed to check EFS FileSystem deletion"
      return 1
    fi

    sleep 10
  done

  echo "ERROR: Timed out waiting for EFS FileSystem deletion"
  return 1
}

# ------------------------------------------------------------------------------------------
# Function Name ......: deleteEKSnodeGroup
# Function Purpose ...: Delete EFS NodeGroup
# ------------------------------------------------------------------------------------------
# Argument ($1) ......:
# Dependencies: ......: AWS_PROFILE, EKS_REGION, EKS_CLUSTER_NAME
# ------------------------------------------------------------------------------------------
# Return Value .......:
# ------------------------------------------------------------------------------------------
deleteEKSnodeGroup() {
  messageTitle "Delete EKS Cluster and Node Groups"

  nodegroups=$(aws eks list-nodegroups \
    --cluster-name "$EKS_CLUSTER_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$EKS_REGION" \
    --query 'nodegroups[]' \
    --output text 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ]; then

    if grep -q 'ResourceNotFoundException' /tmp/error.log; then
      echo " ▪ EKS Cluster ($EKS_CLUSTER_NAME) already deleted"
      echo " ▪ GPU EKS NodeGroups already deleted"
      return 0
    fi

    logMessages /tmp/error.log
    echo "ERROR: Failed to list EKS node groups"
    return 1
  fi

  FOUND=0

  for nodegroup in $nodegroups; do

    if [ "$nodegroup" != "gpu-ondemand-ng" ] && [ "$nodegroup" != "gpu-spot-ng" ]; then
      continue
    fi

    FOUND=1

    echo " ▪ Deleting EKS NodeGroup ($nodegroup)"

    eksctl delete nodegroup \
      --cluster "$EKS_CLUSTER_NAME" \
      --name "$nodegroup" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --disable-eviction > /tmp/error.log 2>&1
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to delete EKS NodeGroup ($nodegroup)"
      return 1
    fi

    echo " ▪ Waiting for EKS NodeGroup ($nodegroup) deletion..."

    aws eks wait nodegroup-deleted \
      --cluster-name "$EKS_CLUSTER_NAME" \
      --nodegroup-name "$nodegroup" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" > /tmp/error.log 2>&1
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Timed out waiting for EKS NodeGroup ($nodegroup) deletion"
      return 1
    fi

    echo " ▪ EKS NodeGroup ($nodegroup) successfully deleted"

  done

  if [ $FOUND -eq 0 ]; then
    echo " ▪ GPU EKS NodeGroups already deleted"
  fi

  return 0
}

