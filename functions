# ------------------------------------------------------------------------------------------
# Function Name ......: checkLocalConfig
# Function Purpose ...: Verify Installed CLI Utilities for Mac
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: none
# Dependancies: ......: messageLine()
# ------------------------------------------------------------------------------------------
# Return Value .......: none
# ------------------------------------------------------------------------------------------
checkLocalConfig() {
  local missing_variables=0
  [ ! -d $HOME/.faig ] && mkdir -p $HOME/.faig
  [ -f $HOME/.faig/config ] && . $HOME/.faig/config

  # Get AWS Region from Cluster Config
  #export AWS_REGION=$(egrep "region:" files/$EKS_CONFIG | awk '{ print $NF }')

  # Set Default Variables
  [ -z "$ECR_STAGEDIR" ] && ECR_STAGEDIR=/tmp/faig_$ECR_FORTIAIGATE_TAG
#  [ -z "$FAIG_LICENSE_DIR" ] && FAIG_LICENSE_DIR=$HOME/.faig/licenses
  [ -z "$EKS_ODMD_NG_NODES" ] && EKS_ODMD_NG_NODES=1
  [ -z "$EKS_SPOT_NG_NODES" ] && EKS_SPOT_NG_NODES=1

  if [ -z "$EKS_CLUSTER_NAME" -o -z "$AWS_PROFILE" -o -z "$AWS_REGION" -o -z "$FAIG_LICENSE_DIR" -o -z "$ECR_FORTIAIGATE_TAG" -o \
       -z "$ECR_FORTIAIGATE_SOURCE_DIR" -o -z "$ECR_REGION" ]; then
    missing_variables=1
    echo ""
    echo "  MISSING ENVIRONMENT-VARIABES          DESCRIPTION        "
    echo "  -------------------------------------------------------------------------------------------------------------------------------------------------------"

    if [ "${FAIG_LICENSE_DIR}" == "" ]; then
      echo "  FAIG_LICENSE_DIR                      (required) EKS Cluster Name"
      echo "                                                   => ie. FAIG_LICENSE_DIR=$HOME/.faig/licenses"
    fi

    if [ "${AWS_PROFILE}" == "" ]; then
      echo "  AWS_PROFILE                           (required) AWS IAM Profile"
      echo "                                                   => ie. AdministratorAccess-149536468416"
    fi

    if [ "${AWS_REGION}" == "" ]; then
      echo "  AWS_REGION                            (required) AWS Region with Spot Instances"
      echo "                                                   => ie. eu-north-1"
    fi

    if [ "${ECR_FORTIAIGATE_TAG}" == "" ]; then
      echo "  ECR_FORTIAIGATE_TAG                   (required) FortiAIgate Repository Tag"
      echo "                                                   => ie. build0020"
    fi

    if [ "${ECR_FORTIAIGATE_SOURCE_DIR}" == "" ]; then
      echo "  ECR_FORTIAIGATE_SOURCE_DIR            (required) AWS Region with Spot Instances"
      echo "                                                   => default: \$HOME/Downloads/FAIG/$ECR_FORTIAIGATE_TAG"
    fi

    if [ "${ECR_REGION}" == "" ]; then
      echo "  ECR_REGION                            (required) AWS Region for ECR Repository"
      echo "                                                   => ie. eu-north-1"
    fi
  fi

  if [ "$ROUTE53_DNS_UPDATES" == "true" -o "$ROUTE53_DNS_UPDATES" == "True" -o "$ROUTE53_DNS_UPDATES" == "TRUE" ]; then 
    if [ -z "$ROUTE53_HOSTED_ZONE_ID" -o -z "$ROUTE53_DOMAIN" -o -z "$ROUTE53_REGION" ]; then
      local missing_variables=1
      echo ""
      echo "  MISSING ENVIRONMENT-VARIABES          DESCRIPTION        "
      echo "  -------------------------------------------------------------------------------------------------------------------------------------------------------"
    
      if [ -z "${ROUTE53_HOSTED_ZONE_ID}" ]; then
        echo "  ROUTE53_HOSTED_ZONE_ID                 (required) AWS Route54 ZoneID"
      fi

      if [ -z "${ROUTE53_DOMAIN}" ]; then
        echo "  ROUTE53_DOMAIN                         (required) AWS Domain Name"
        echo "                                                   => ie. fortiaigate.fortidemo.ch"
      fi

      if [ -z "${ROUTE53_REGION}" ]; then
        echo "  ROUTE53_REGION                         (required) AWS Route53 Region"
        echo "                                                   => ie. eu-north-1"
      fi
    fi
  fi

  if [ ! -f $HOME/.faig/config ]; then
    echo "export AWS_REGION=\"\""                              >  $HOME/.faig/config
    echo "EKS_CLUSTER_NAME=\"\""                               >> $HOME/.faig/config
    echo "EKS_ODMD_NG_NODES=1\"\""                             >> $HOME/.faig/config
    echo "EKS_SPOT_NG_NODES=3\"\""                             >> $HOME/.faig/config
    echo ""                                                    >> $HOME/.faig/config
    echo "# AWS Access Credentials"                            >> $HOME/.faig/config
    echo "AWS_PROFILE=\"\""                                    >> $HOME/.faig/config
    echo ""                                                    >> $HOME/.faig/config
    echo "# AWS Rout54 Access Credentials"                     >> $HOME/.faig/config
    echo "ROUTE53_DNS_UPDATES=\"false\""                        >> $HOME/.faig/config
    echo "ROUTE53_REGION=\"\""                                  >> $HOME/.faig/config
    echo "ROUTE53_ACCESS_KEY_ID=\"\""                           >> $HOME/.faig/config
    echo "ROUTE53_SECRET_ACCESS_KEY=\"\""                       >> $HOME/.faig/config
    echo "ROUTE53_HOSTED_ZONE_ID=\"\""                          >> $HOME/.faig/config
    echo "ROUTE53_DOMAIN=\"\""                                  >> $HOME/.faig/config
    echo ""                                                    >> $HOME/.faig/config
    echo "# FortiAiGate (FAIG) Configuration"                  >> $HOME/.faig/config
    echo "FAIG_LICENSE_DIR=\"\$HOME/.faid/licenses\""          >> $HOME/.faig/config
    echo ""                                                    >> $HOME/.faig/config
    echo "# AWS RCR Repository Configuration"                  >> $HOME/.faig/config
    echo "ECR_FORTIAIGATE_SOURCE_DIR=\"\""                     >> $HOME/.faig/config
    echo "ECR_FORTIAIGATE_TAG=\"\""                            >> $HOME/.faig/config
    echo "ECR_REGION=\"\""                                     >> $HOME/.faig/config
    echo "ECR_STAGEDIR=\"/tmp/faig_$ECR_FORTIAIGATE_TAG\""     >> $HOME/.faig/config
  fi

  if [ ${missing_variables} -eq 1 ]; then
    echo "  -------------------------------------------------------------------------------------------------------------------------------------------------------"
    echo "  IMPORTANT: Please set the missing environment variables in the configuration file \$HOME/.faig/config"
    echo "  -------------------------------------------------------------------------------------------------------------------------------------------------------"
    exit 1
  fi 
} 

