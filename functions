# ------------------------------------------------------------------------------------------
# Function Name ......: prepareEFSinfrastructure
# Function Purpose ...: Create / reuse EFS filesystem, security group and mount targets
# ------------------------------------------------------------------------------------------
# Dependencies .......: EKS_REGION, EKS_CLUSTER_NAME, AWS_PROFILE
# Optional Vars ......: EFS_NAME, EFS_SG_NAME
# Outputs ............: EFS_FILE_SYSTEM_ID, EFS_SECURITY_GROUP_ID
# ------------------------------------------------------------------------------------------
prepareEFSinfrastructure() {

  local EFS_NAME="${EFS_NAME:-efs-$EKS_CLUSTER_NAME}"
  local EFS_SG_NAME="${EFS_SG_NAME:-efs-$EKS_CLUSTER_NAME-sg}"
  local VPC_ID=""
  local VPC_CIDR=""
  local SUBNET_IDS=""
  local subnet=""
  local subnetAzId=""
  local MT_ID=""
  local NFS_RULE=""
  local ret=0

  messageTitle "Prepare Amazon EFS Infrastructure"

  [ -z "$EKS_REGION" ]       && { echo "ERROR: EKS_REGION is not set"; return 1; }
  [ -z "$EKS_CLUSTER_NAME" ] && { echo "ERROR: EKS_CLUSTER_NAME is not set"; return 1; }
  [ -z "$AWS_PROFILE" ]      && { echo "ERROR: AWS_PROFILE is not set"; return 1; }

  # ------------------------------------------------------------------------
  # Get cluster VPC + subnets
  # ------------------------------------------------------------------------
  VPC_ID=$(aws eks describe-cluster \
    --name "$EKS_CLUSTER_NAME" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query 'cluster.resourcesVpcConfig.vpcId' \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 ] || [ -z "$VPC_ID" ] || [ "$VPC_ID" = "None" ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to get VPC ID for cluster $EKS_CLUSTER_NAME"
    return 1
  fi

  SUBNET_IDS=$(aws eks describe-cluster \
    --name "$EKS_CLUSTER_NAME" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query 'cluster.resourcesVpcConfig.subnetIds' \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 ] || [ -z "$SUBNET_IDS" ] || [ "$SUBNET_IDS" = "None" ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to get subnet IDs for cluster $EKS_CLUSTER_NAME"
    return 1
  fi

  VPC_CIDR=$(aws ec2 describe-vpcs \
    --vpc-ids "$VPC_ID" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query 'Vpcs[0].CidrBlock' \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 ] || [ -z "$VPC_CIDR" ] || [ "$VPC_CIDR" = "None" ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to get VPC CIDR"
    return 1
  fi

  echo " ▪ VPC_ID ...............: $VPC_ID"
  echo " ▪ VPC_CIDR .............: $VPC_CIDR"
  echo " ▪ SUBNET_IDS ...........: $SUBNET_IDS"

  # ------------------------------------------------------------------------
  # Create / reuse EFS filesystem
  # ------------------------------------------------------------------------
  EFS_FILE_SYSTEM_ID=$(aws efs describe-file-systems \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query "FileSystems[?Name=='$EFS_NAME'].FileSystemId | [0]" \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to query EFS file systems"
    return 1
  fi

  if [ -z "$EFS_FILE_SYSTEM_ID" ] || [ "$EFS_FILE_SYSTEM_ID" = "None" ]; then
    echo " ▪ Create EFS filesystem : $EFS_NAME"

    EFS_FILE_SYSTEM_ID=$(aws efs create-file-system \
      --creation-token "$EFS_NAME" \
      --performance-mode generalPurpose \
      --encrypted \
      --tags Key=Name,Value="$EFS_NAME" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'FileSystemId' \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 ] || [ -z "$EFS_FILE_SYSTEM_ID" ] || [ "$EFS_FILE_SYSTEM_ID" = "None" ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to create EFS filesystem"
      return 1
    fi
  else
    echo " ▪ EFS filesystem exists : $EFS_FILE_SYSTEM_ID"
  fi

  # ------------------------------------------------------------------------
  # Wait until EFS filesystem is available
  # ------------------------------------------------------------------------
  echo " ▪ Waiting for EFS filesystem availability"

  local EFS_STATE=""
  local attempt=0

  while [ $attempt -lt 30 ]; do

    EFS_STATE=$(aws efs describe-file-systems \
      --file-system-id "$EFS_FILE_SYSTEM_ID" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'FileSystems[0].LifeCycleState' \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to query EFS filesystem status"
      return 1
    fi

    if [ "$EFS_STATE" = "available" ]; then
      echo " ▪ EFS filesystem ready .: $EFS_FILE_SYSTEM_ID"
      break
    fi

    if [ "$EFS_STATE" != "creating" ]; then
      echo "ERROR: Unexpected EFS filesystem state: $EFS_STATE"
      return 1
    fi

    attempt=$((attempt + 1))
    sleep 10
  done

  if [ "$EFS_STATE" != "available" ]; then
    echo "ERROR: Timeout waiting for EFS filesystem"
    return 1
  fi

  # ------------------------------------------------------------------------
  # Create / reuse EFS security group
  # ------------------------------------------------------------------------
  EFS_SECURITY_GROUP_ID=$(aws ec2 describe-security-groups \
    --filters Name=vpc-id,Values="$VPC_ID" Name=group-name,Values="$EFS_SG_NAME" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query 'SecurityGroups[0].GroupId' \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to query EFS security groups"
    return 1
  fi

  if [ -z "$EFS_SECURITY_GROUP_ID" ] || [ "$EFS_SECURITY_GROUP_ID" = "None" ]; then
    echo " ▪ Create EFS SG ........: $EFS_SG_NAME"

    EFS_SECURITY_GROUP_ID=$(aws ec2 create-security-group \
      --group-name "$EFS_SG_NAME" \
      --description "EFS Security Group for $EKS_CLUSTER_NAME" \
      --vpc-id "$VPC_ID" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'GroupId' \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 ] || [ -z "$EFS_SECURITY_GROUP_ID" ] || [ "$EFS_SECURITY_GROUP_ID" = "None" ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to create EFS security group"
      return 1
    fi
  else
    echo " ▪ EFS SG exists ........: $EFS_SECURITY_GROUP_ID"
  fi

  # ------------------------------------------------------------------------
  # Ensure NFS ingress rule exists (TCP 2049 from VPC CIDR)
  # ------------------------------------------------------------------------
  NFS_RULE=$(aws ec2 describe-security-groups \
    --group-ids "$EFS_SECURITY_GROUP_ID" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query "SecurityGroups[0].IpPermissions[?IpProtocol=='tcp' && FromPort==\`2049\` && ToPort==\`2049\`].IpRanges[].CidrIp" \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to query EFS NFS ingress rules"
    return 1
  fi

  if ! printf '%s\n' "$NFS_RULE" | tr '\t' '\n' | grep -Fxq "$VPC_CIDR"; then
    echo " ▪ Authorize NFS access .: TCP 2049 ($VPC_CIDR)"

    aws ec2 authorize-security-group-ingress \
      --group-id "$EFS_SECURITY_GROUP_ID" \
      --protocol tcp \
      --port 2049 \
      --cidr "$VPC_CIDR" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      > /tmp/error.log 2>&1; ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to authorize EFS security group ingress"
      return 1
    fi
  fi

  # ------------------------------------------------------------------------
  # Create mount target per AZ
  # ------------------------------------------------------------------------
  for subnet in $SUBNET_IDS; do

    subnetAzId=$(aws ec2 describe-subnets \
      --subnet-ids "$subnet" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'Subnets[0].AvailabilityZoneId' \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 ] || [ -z "$subnetAzId" ] || [ "$subnetAzId" = "None" ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to get AZ ID for subnet $subnet"
      return 1
    fi

    MT_ID=$(aws efs describe-mount-targets \
      --file-system-id "$EFS_FILE_SYSTEM_ID" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query "MountTargets[?AvailabilityZoneId=='$subnetAzId'].MountTargetId | [0]" \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to query mount targets"
      return 1
    fi

    if [ -z "$MT_ID" ] || [ "$MT_ID" = "None" ]; then
      echo " ▪ Create mount target ..: $subnet ($subnetAzId)"

      aws efs create-mount-target \
        --file-system-id "$EFS_FILE_SYSTEM_ID" \
        --subnet-id "$subnet" \
        --security-groups "$EFS_SECURITY_GROUP_ID" \
        --region "$EKS_REGION" \
        --profile "$AWS_PROFILE" \
        > /tmp/error.log 2>&1; ret=$?

      if [ $ret -ne 0 ]; then
        logMessages /tmp/error.log
        echo "ERROR: Failed to create mount target for subnet $subnet"
        return 1
      fi
    else
      echo " ▪ Mount target exists ..: $subnet ($subnetAzId)"
    fi
  done

  # ------------------------------------------------------------------------
  # Save deployment state
  # ------------------------------------------------------------------------
  {
    grep -v '^export EFS_FILE_SYSTEM_ID=' "$HOME/.faig/deploy.stat" 2>/dev/null | \
    grep -v '^export EFS_SECURITY_GROUP_ID='
    echo "export EFS_FILE_SYSTEM_ID=$EFS_FILE_SYSTEM_ID"
    echo "export EFS_SECURITY_GROUP_ID=$EFS_SECURITY_GROUP_ID"
  } > /tmp/faig.stat.$$ && mv /tmp/faig.stat.$$ "$HOME/.faig/deploy.stat"

  echo " ▪ EFS_FILE_SYSTEM_ID ...: $EFS_FILE_SYSTEM_ID"
  echo " ▪ EFS_SECURITY_GROUP_ID : $EFS_SECURITY_GROUP_ID"

  return 0
}

# ------------------------------------------------------------------------------------------
# Function Name ......: installEBSCSIDriver
# Function Purpose ...: Install Amazon EBS CSI driver addon for EKS if not already present
# Dependencies .......: AWS_REGION, EKS_CLUSTER_NAME, aws, eksctl, kubectl
# ------------------------------------------------------------------------------------------
installEBSCSIDriver() {
  local EBS_ADDON_NAME="aws-ebs-csi-driver"
  local ADDON_STATUS=""
  local RET=0
  local TIMEOUT=600
  local WAITED=0

  messageTitle "Amazon EBS CSI Driver for EKS Kubernetes Cluster"

  # ----------------------------------------------------------------------------------------
  # Check whether the EBS CSI addon is already installed
  # ----------------------------------------------------------------------------------------
  ADDON_STATUS=$(aws eks describe-addon \
    --cluster-name "$EKS_CLUSTER_NAME" \
    --addon-name "$EBS_ADDON_NAME" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query 'addon.status' \
    --output text 2>/tmp/error.log)
  RET=$?

  if [ $RET -eq 0 ]; then
    echo " ▪ EBS CSI addon already present .: $EBS_ADDON_NAME ($ADDON_STATUS)"
  else
    if grep -qiE 'ResourceNotFoundException|No addon found' /tmp/error.log 2>/dev/null; then
      echo " ▪ Installing EBS CSI addon .....: $EBS_ADDON_NAME"

      eksctl create addon \
        --name "$EBS_ADDON_NAME" \
        --cluster "$EKS_CLUSTER_NAME" \
        --profile "$AWS_PROFILE" \
        --region "$EKS_REGION" \
        --force >/tmp/error.log 2>&1
      RET=$?

      if [ $RET -ne 0 ]; then
        logMessages /tmp/error.log
        echo "ERROR: Installing EBS CSI addon failed"
        echo "       => eksctl create addon --name $EBS_ADDON_NAME --cluster $EKS_CLUSTER_NAME --region $EKS_REGION --force"
        exit 1
      fi
    else
      logMessages /tmp/error.log
      echo "ERROR: Failed to check whether EBS CSI addon exists"
      echo "       => aws eks describe-addon --cluster-name $EKS_CLUSTER_NAME --addon-name $EBS_ADDON_NAME --region $EKS_REGION"
      exit 1
    fi
  fi

  # ----------------------------------------------------------------------------------------
  # Wait until addon becomes ACTIVE
  # ----------------------------------------------------------------------------------------
  echo " ▪ Waiting for EBS CSI addon to become ACTIVE ..."
  while true; do
    ADDON_STATUS=$(aws eks describe-addon \
      --cluster-name "$EKS_CLUSTER_NAME" \
      --addon-name "$EBS_ADDON_NAME" \
       --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --query 'addon.status' \
      --output text 2>/tmp/error.log)
    RET=$?

    if [ $RET -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to read EBS CSI addon status"
      exit 1
    fi

    echo " ▪ EBS CSI addon status ........: $ADDON_STATUS"

    if [ "$ADDON_STATUS" = "ACTIVE" ]; then
      break
    fi

    sleep 10
    WAITED=$((WAITED + 10))

    if [ $WAITED -ge $TIMEOUT ]; then
      echo "ERROR: Timeout waiting for EBS CSI addon to become ACTIVE"
      exit 1
    fi
  done

  # ----------------------------------------------------------------------------------------
  # Verify Kubernetes EBS CSI resources
  # ----------------------------------------------------------------------------------------
  echo " ▪ Checking Kubernetes EBS CSI pods ..."
  kubectl -n kube-system get pods | grep ebs-csi >/tmp/ebs-csi-pods.log 2>&1
  RET=$?

  if [ $RET -ne 0 ]; then
    cat /tmp/ebs-csi-pods.log 2>/dev/null
    echo "ERROR: EBS CSI addon is ACTIVE in EKS, but no ebs-csi pods were found in kube-system"
    exit 1
  fi

  #cat /tmp/ebs-csi-pods.log
  echo " ▪ EBS CSI driver is installed and available"
}

# ------------------------------------------------------------------------------------------
# Function Name ......: installEFSCSIDriver
# Function Purpose ...: Install / upgrade AWS EFS CSI driver with IAM service account
# ------------------------------------------------------------------------------------------
# Dependencies .......: EKS_REGION, EKS_CLUSTER_NAME, AWS_PROFILE
# Optional Vars ......: EFS_CSI_NAMESPACE, EFS_CSI_SA_NAME, EFS_CSI_RELEASE
# ------------------------------------------------------------------------------------------
installEFSCSIDriver() {

  local EFS_CSI_DEPLOYMENT="${EFS_CSI_DEPLOYMENT:-efs-csi-controller}"
  local EFS_CSI_NAMESPACE="${EFS_CSI_NAMESPACE:-kube-system}"
  local EFS_CSI_SA_NAME="${EFS_CSI_SA_NAME:-efs-csi-controller-sa}"
  local EFS_CSI_RELEASE="${EFS_CSI_RELEASE:-aws-efs-csi-driver}"
  local EFS_POLICY_ARN="arn:aws:iam::aws:policy/service-role/AmazonEFSCSIDriverPolicy"
  local ROLE_ARN=""
  local ret=0

  messageTitle "Install Amazon EFS CSI Driver"

  [ -z "$EKS_REGION" ]       && { echo "ERROR: EKS_REGION is not set"; return 1; }
  [ -z "$EKS_CLUSTER_NAME" ] && { echo "ERROR: EKS_CLUSTER_NAME is not set"; return 1; }
  [ -z "$AWS_PROFILE" ]      && { echo "ERROR: AWS_PROFILE is not set"; return 1; }

  # ------------------------------------------------------------------------
  # Create / reuse IAM service account
  # ------------------------------------------------------------------------
  ROLE_ARN=$(kubectl get sa "$EFS_CSI_SA_NAME" \
    -n "$EFS_CSI_NAMESPACE" \
    -o jsonpath='{.metadata.annotations.eks\.amazonaws\.com/role-arn}' \
    2>/dev/null)

  if [ -z "$ROLE_ARN" ]; then

    echo " ▪ Create / update IAM SA : $EFS_CSI_SA_NAME"

    eksctl create iamserviceaccount \
      --cluster "$EKS_CLUSTER_NAME" \
      --namespace "$EFS_CSI_NAMESPACE" \
      --name "$EFS_CSI_SA_NAME" \
      --attach-policy-arn "$EFS_POLICY_ARN" \
      --approve \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --override-existing-serviceaccounts > /tmp/error.log 2>&1
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to create/update IAM service account for EFS CSI driver"
      return 1
    fi

    ROLE_ARN=$(kubectl get sa "$EFS_CSI_SA_NAME" \
      -n "$EFS_CSI_NAMESPACE" \
      -o jsonpath='{.metadata.annotations.eks\.amazonaws\.com/role-arn}' \
      2>/dev/null)

    if [ -z "$ROLE_ARN" ]; then
      echo "ERROR: EFS CSI service account has no role annotation"
      return 1
    fi

  else
    echo " ▪ IAM SA exists ........: $EFS_CSI_SA_NAME"
  fi

  echo " ▪ EFS CSI role ARN .....: $ROLE_ARN"

  # ------------------------------------------------------------------------
  # Install / upgrade EFS CSI driver
  # ------------------------------------------------------------------------
  helm repo add aws-efs-csi-driver \
    https://kubernetes-sigs.github.io/aws-efs-csi-driver/ \
    > /tmp/error.log 2>&1 || true

  helm repo update > /tmp/error.log 2>&1
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to update Helm repositories"
    return 1
  fi

  echo " ▪ Install / upgrade ....: $EFS_CSI_RELEASE"

  helm upgrade --install "$EFS_CSI_RELEASE" \
    aws-efs-csi-driver/aws-efs-csi-driver \
    --namespace "$EFS_CSI_NAMESPACE" \
    --set controller.serviceAccount.create=false \
    --set controller.serviceAccount.name="$EFS_CSI_SA_NAME" \
    > /tmp/error.log 2>&1
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to install/upgrade EFS CSI driver"
    return 1
  fi

  # ------------------------------------------------------------------------
  # Wait for EFS CSI controller
  # ------------------------------------------------------------------------
  echo " ▪ Waiting for EFS CSI controller..."

  kubectl rollout status "deployment/$EFS_CSI_DEPLOYMENT" \
    -n "$EFS_CSI_NAMESPACE" \
    --timeout=180s > /tmp/error.log 2>&1
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: EFS CSI driver rollout failed"
    return 1
  fi

  echo " ▪ EFS CSI driver ready"

  return 0
}

# ------------------------------------------------------------------------------------------
# Function Name ......: installEFSstorageClass
# Function Purpose ...: Create / update EFS StorageClass (shared or FortiAIGate dedicated)
# ------------------------------------------------------------------------------------------
# Dependencies .......: EFS_FILE_SYSTEM_ID, EFS_STORAGE_CLASS
# Optional Vars ......: EFS_MODE=[shared|faig]
# ------------------------------------------------------------------------------------------
installEFSstorageClass() {

  local EFS_MODE="${EFS_MODE:-faig}"
  local ret=0

  messageTitle "Install Amazon EFS StorageClass"

  [ -z "$EFS_FILE_SYSTEM_ID" ] && { echo "ERROR: EFS_FILE_SYSTEM_ID is not set"; exit 1; }
  [ -z "$EFS_STORAGE_CLASS" ]  && { echo "ERROR: EFS_STORAGE_CLASS is not set"; exit 1; }

  case "$EFS_MODE" in
    shared)
      cat > /tmp/efs-storageclass.yaml <<EOF
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: $EFS_STORAGE_CLASS
provisioner: efs.csi.aws.com
parameters:
  provisioningMode: efs-ap
  fileSystemId: $EFS_FILE_SYSTEM_ID
  directoryPerms: "700"
reclaimPolicy: Delete
volumeBindingMode: Immediate
EOF
      ;;
    faig)
      cat > /tmp/efs-storageclass.yaml <<EOF
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: $EFS_STORAGE_CLASS
provisioner: efs.csi.aws.com
parameters:
  provisioningMode: efs-ap
  fileSystemId: $EFS_FILE_SYSTEM_ID
  basePath: "/fortiaigate"
  directoryPerms: "770"
  uid: "1001"
  gid: "1001"
reclaimPolicy: Delete
volumeBindingMode: Immediate
EOF
      ;;
    *)
      echo "ERROR: Unsupported EFS_MODE '$EFS_MODE' (expected: shared or faig)"
      exit 1
      ;;
  esac

  echo " ▪ Apply StorageClass ....: $EFS_STORAGE_CLASS ($EFS_MODE)"
  kubectl apply -f /tmp/efs-storageclass.yaml > /tmp/error.log 2>&1; ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to apply EFS StorageClass"
    exit 1
  fi

  echo "   ---------------------------------------------------------------------------------------------------------------------"
  kubectl get storageclass "$EFS_STORAGE_CLASS" | sed 's/^/   /g'
  echo "   -------------------------------------------------------------------------------------------------------------------------------------------------------"
}

# ------------------------------------------------------------------------------------------
# Function Name ......: installMCPFileServer
# Function Purpose ...: Install the MCP File Server
# ------------------------------------------------------------------------------------------
# Dependencies .......: 
# Optional Vars ......: 
# ------------------------------------------------------------------------------------------
installMCPFileServer() {
  APP_NAMESPACE="filesystem-mcp-server"
    
  messageTitle "Deploy MCP File Server"

  NAMESPACE="filesystem-mcp-server"
  MANIFEST="filesystem-mcp-server/filesystem-mcp-server.yaml"

  kubectl get namespace "$APP_NAMESPACE" >/dev/null 2>&1; ret=$?
  if [ $ret -ne 0 ]; then
    echo " ▪ Create Namespace ....: $APP_NAMESPACE"
    kubectl create namespace "$APP_NAMESPACE" > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Creating namespace failed"
      echo "       => kubectl create namespace $APP_NAMESPACE"
      exit 1
    fi
  else
    echo " ▪ Namespace already exists"
  fi

  # Apply on every run to create missing ingress or reconcile its configuration.
  echo " ▪ Deploying filesystem MCP .......: $MANIFEST"
  kubectl -n $APP_NAMESPACE apply -f $MANIFEST > /tmp/error.log 2>&1; ret=$?
  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Deploying MCP Fileserver failed"
    echo "       => kubectl -n $APP_NAMESPACE apply -f $MANIFEST"
    return 1
  fi

  kubectl rollout status deployment/filesystem-mcp -n "$NAMESPACE" --timeout=120s > /dev/null 2>&1
}

# ------------------------------------------------------------------------------------------
# Function Name ......: installOpenWebUI
# Function Purpose ...: Install OpenWebUI
# ------------------------------------------------------------------------------------------
# Dependencies .......: EFS_FILE_SYSTEM_ID, EFS_STORAGE_CLASS
# Optional Vars ......: EFS_MODE=[shared|faig]
# ------------------------------------------------------------------------------------------
installOpenWebUI() {

  APP_NAMESPACE="open-webui"
  APP_INGRESS="webui-ingress"
  APP_URL="webui.$ROUTE53_DOMAIN"
    
  messageTitle "Deploy WebUI Ingress"
  
  CERT_ARN=$(getCertARN "*.$ROUTE53_DOMAIN")
  ret=$?
  if [ $ret -ne 0 -o -z "$CERT_ARN" ]; then
    echo "ERROR: Failed to get Certificate ARN"
    echo "       => getCertARN \"*.$ROUTE53_DOMAIN\""
    return 1
  fi

    
  echo " ▪ CERT_ARN ............: $CERT_ARN"      
    
