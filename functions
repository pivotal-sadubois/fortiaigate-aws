# ------------------------------------------------------------------------------------------
# Function Name ......: verifySpotPlacementScrores
# Function Purpose ...: Verify Spot Placement Scores
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: AWS_REGION
# Dependancies: ......: 
#                     :
# ------------------------------------------------------------------------------------------
# Return Value .......: Placement Score (1, 2 or 3)
# ------------------------------------------------------------------------------------------
verifySpotPlacementScrores() {
  REGION="$1"

  aws ec2 get-spot-placement-scores \
      --target-capacity 1 \
      --single-availability-zone \
      --instance-types g5.2xlarge g5.4xlarge --no-cli-pager > /tmp/tempfile.json

  if [ "$REGION" == "" ]; then 
    cat /tmp/tempfile.json
  else
    avz=$(jq -r --arg key "$REGION" '[.SpotPlacementScores[] | select(.Region == $key) | .AvailabilityZoneId] | join(" ")' /tmp/tempfile.json)

    score=0
    for n in $avz; do
      scr=$(jq -r --arg reg "$REGION" --arg avz "$n" '.SpotPlacementScores[] | select(.Region == $reg and .AvailabilityZoneId == $avz).Score' /tmp/tempfile.json)
      let score=score+scr
    done

    echo "$score"
  fi
}


# ------------------------------------------------------------------------------------------
# Function Name ......: checkNodeAvailability
# Function Purpose ...: Check Node Availability in a AWS Region
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: EKS_REGION
# Argument ($2) ......: EKS_INSTANCE
# ------------------------------------------------------------------------------------------
# Return Value .......: 
# ------------------------------------------------------------------------------------------
checkNodeAvailability() {
  eks_region=$1
  eks_instance=$2

  aws ec2 describe-instance-type-offerings \
    --profile "$AWS_PROFILE" \
    --region "$eks_region" \
    --location-type availability-zone \
    --filters "Name=instance-type,Values=$eks_instance" \
    --query 'InstanceTypeOfferings[].Location' \
    --output text
}

# ------------------------------------------------------------------------------------------
# Function Name ......: multiRegionodeReservation
# Function Purpose ...: Search Multi Regions for a Node Reservation
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: EKS_REGION
# Argument ($2) ......: EKS_AZ
# Argument ($3) ......: EKS_INSTANCE_TYPE
# Return Value .......: Reservation ID on success, empty on failure
# ------------------------------------------------------------------------------------------
multiRegionodeReservation() {
  #local EKS_REGION_LIST="eu-south-2 eu-central-1 eu-north-1 us-east-1 us-east-2 us-west-2"
  local EKS_REGION_LIST="eu-north-1 eu-south-2 eu-central-1 us-east-1 us-east-2 us-west-2"
  local EKS_INSTANCE_LIST="g6e.2xlarge g6e.4xlarge"

  reservation_id=""
  for region in $EKS_REGION_LIST; do
    messageTitle "Search for Available GPU Nodes in region: $region"
   
    # Verify if the region is enabled in your AWS account
    stt=$(aws account get-region-opt-status \
      --region-name $region \
      --region us-east-1 \
      --profile "$AWS_PROFILE" \
      --query 'RegionOptStatus' \
      --output text)
  
    if [ "$stt" != "ENABLED" ] && [ "$stt" != "ENABLED_BY_DEFAULT" ]; then
      echo "   -----------------------------------------------------------------------------------------"
      echo "   ERROR: The AWS Region $region is not enabled in your account and will be skipped"
      echo "          pleaes run the following command to enable it:"
      echo "          => aws account enable-region --region-name $region"
      echo "                 --region us-east-1  --profile \"$AWS_PROFILE\""
      echo "   -----------------------------------------------------------------------------------------"
      continue
    fi
  
    # Verify if there is already a reservation
    # ie. cr-0b0a8b531c783f6b4    g6e.4xlarge     eu-central-1a   1       1       active
    str=$(aws ec2 describe-capacity-reservations \
      --region "$region" \
      --profile "$AWS_PROFILE" \
      --filters "Name=state,Values=active" \
                "Name=instance-type,Values=g6e.2xlarge,g6e.4xlarge" \
      --query 'CapacityReservations[?AvailableInstanceCount>`0`].[CapacityReservationId,InstanceType,AvailabilityZone,TotalInstanceCount,AvailableInstanceCount,State]' \
      --output text 2>/tmp/error.log); result=$?

    if [ $result -ne 0 ]; then
      cat /tmp/error.log
      return 1
    fi

    if [ "$str" != "" ]; then 
      EKS_REGION="$region"
      reservation_id=$(echo "$str" | awk 'NR==1 { print $1 }')
      INSTANCE_TYPE=$(echo "$str" | awk 'NR==1 { print $2 }')
      EKS_AZ=$(echo "$str" | awk 'NR==1 { print $3 }')
  
      echo " ▪ Existing Node Reservation found in AZ: $EKS_AZ for Instance: $INSTANCE_TYPE => Successful ($reservation_id)"
      showNodeReservation "$EKS_REGION"
      break
    else
      for instance in $EKS_INSTANCE_LIST; do
        AVAILABILITY_ZONES=$(checkNodeAvailability "$region" "$instance")
  
        for az in $AVAILABILITY_ZONES; do
          reservation_id=$(createNodeReservation "$region" "$az" "$instance")
  
          if [ -n "$reservation_id" ]; then
            echo " ▪ Create Node Reservation in AZ: $az for Instance: $instance => Successful ($reservation_id)"
  
            EKS_REGION="$region"
            EKS_AZ="$az"
            INSTANCE_TYPE="$instance"
    
            showNodeReservation "$EKS_REGION"
  
            break 3
          else
            echo " ▪ Create Node Reservation in AZ: $az for Instance: $instance => Failed"
          fi
        done
      done
    fi
  done

  if [ -z "$reservation_id" ]; then
    echo "Failed to get a GPU Node Reservation"
    return 1
  fi

  # Find a second availability zone for EKS networking
  SECOND_AZ=$(aws ec2 describe-availability-zones \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --filters "Name=state,Values=available" \
    --query "AvailabilityZones[?ZoneName!='${EKS_AZ}'].ZoneName | [0]" \
    --output text 2>/tmp/error.log); result=$?

  if [ $result -ne 0 ] || [ -z "$SECOND_AZ" ] || [ "$SECOND_AZ" = "None" ]; then
    echo "Failed to find a second availability zone in $EKS_REGION"
    cat /tmp/error.log
    return 1
  fi

  echo " ▪ GPU Reservation AZ: $EKS_AZ"
  echo " ▪ Second EKS AZ ....: $SECOND_AZ"

  echo " ▪  Write EKS configuration to state file (\$HOME/.faig/deploy.stat)"
  echo "export EKS_CLUSTER_NAME=$EKS_CLUSTER_NAME"       >  $HOME/.faig/deploy.stat
  echo "export EKS_REGION=$EKS_REGION"                   >> $HOME/.faig/deploy.stat
  echo "export EKS_INSTANCE_TYPE=$INSTANCE_TYPE"         >> $HOME/.faig/deploy.stat
  echo "export RESERVATION_ID=$reservation_id"           >> $HOME/.faig/deploy.stat
  echo "export AZ=$EKS_AZ"                               >> $HOME/.faig/deploy.stat
  echo "export SECOND_AZ=$SECOND_AZ"                     >> $HOME/.faig/deploy.stat

 echo " ▪ Create EKS Node Configuration (/tmp/eks-cluster.yaml)"
  sed -e "s/INSTANCE/$INSTANCE_TYPE/g" \
      -e "s/CLUSTER/$EKS_CLUSTER_NAME/g" \
      -e "s/REGION/$EKS_REGION/g" \
      -e "s/SECOND_AZ/$SECOND_AZ/g" \
      -e "s/AZ/$EKS_AZ/g" \
      -e "s/RESERVATION_ID/$reservation_id/g" \
         files/eks-cluster-template.yaml > /tmp/eks-cluster.yaml

  return 0
}

# ------------------------------------------------------------------------------------------
# Function Name ......: createNodeReservation
# Function Purpose ...: Create a Node Reservation
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: EKS_REGION
# Argument ($2) ......: EKS_AZ
# Argument ($3) ......: EKS_INSTANCE_TYPE
# Return Value .......: Reservation ID on success, empty on failure
# ------------------------------------------------------------------------------------------
createNodeReservation() {
  local eks_region=$1
  local eks_az=$2
  local eks_instance=$3
  local reservation_id

  reservation_id=$(aws ec2 create-capacity-reservation \
    --region "$eks_region" \
    --profile "$AWS_PROFILE" \
    --instance-type "$eks_instance" \
    --instance-platform Linux/UNIX \
    --availability-zone "$eks_az" \
    --instance-count 1 \
    --instance-match-criteria targeted \
    --end-date-type unlimited \
    --query 'CapacityReservation.CapacityReservationId' \
    --output text 2>/tmp/error.log)

  if [ $? -eq 0 ] && [ -n "$reservation_id" ] && [ "$reservation_id" != "None" ]; then
    echo "$reservation_id"
    return 0
  else
    #cat /tmp/error.log >&2
    return 1
  fi
}

# ------------------------------------------------------------------------------------------
# Function Name ......: deleteNodeReservation
# Function Purpose ...: Delete all active Node Reservations in a Region
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: EKS_REGION
# ------------------------------------------------------------------------------------------
# Return Value .......: 0 = Success, 1 = Failure
# ------------------------------------------------------------------------------------------
deleteNodeReservation() {
  local eks_region=$1
  local reservation_ids
  local reservation_id
  local confirm

  reservation_ids=$(aws ec2 describe-capacity-reservations \
    --region "$eks_region" \
    --filters Name=state,Values=active \
    --query 'CapacityReservations[].CapacityReservationId' \
    --output text) || return 1

  if [ -z "$reservation_ids" ] || [ "$reservation_ids" = "None" ]; then
    echo " ▪ No active Capacity Reservations found in $eks_region"
    return 0
  fi

  for reservation_id in $reservation_ids; do
    echo " ▪ Cancelling reservation: $reservation_id"

    aws ec2 cancel-capacity-reservation \
      --region "$eks_region" \
      --capacity-reservation-id "$reservation_id" \
      --output json > /dev/null 2>&1; ret=$?

    if [ $ret -ne 0 ]; then 
      echo "   => Failed to cancel ($reservation_id)" >&2
    fi
  done

  return 0
}

# ------------------------------------------------------------------------------------------
# Function Name ......: showNodeReservation
# Function Purpose ...: Delete a Node Reservation
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: EKS_REGION
# Argument ($2) ......: EKS_AZ
# Argument ($3) ......: EKS_INSTANCE_TYPE
# ------------------------------------------------------------------------------------------
# Return Value .......:
# ------------------------------------------------------------------------------------------
showNodeReservation() {
  eks_region=$1

  aws ec2 describe-capacity-reservations \
    --region $eks_region\
    --filters Name=state,Values=active \
    --query 'CapacityReservations[*].[CapacityReservationId,InstanceType,AvailabilityZone,TotalInstanceCount,AvailableInstanceCount,State]' \
    --output table | sed 's/^/   /g'
}


# ------------------------------------------------------------------------------------------
# Function Name ......: installEKSCluster
# Function Purpose ...: Install the EKS Cluster without NodeGroups
# ------------------------------------------------------------------------------------------
# Argument ($1) ......:
# Dependancies: ......: EKS_REGION, EKS_CLUSTER_NAME
# ------------------------------------------------------------------------------------------
# Return Value .......:
# ------------------------------------------------------------------------------------------
installEKSCluster() {
  messageTitle "AWS EKS Kubernetes Cluster Deployment in region $EKS_REGION"

  EKS_CONFIG="/tmp/eks-cluster.yaml"

  cluster=$(aws eks list-clusters --region "$EKS_REGION" | jq --arg key "$EKS_CLUSTER_NAME" -r '.clusters[] | select(. == $key)')
  if [ "$cluster" != "$EKS_CLUSTER_NAME" ]; then
    eksctl create cluster -f $EKS_CONFIG --profile "$AWS_PROFILE" --without-nodegroup --timeout 25m > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Cluster creatation failed"
      exit
    fi

    echo " ▪ Create Create CPU Node Group"
    eksctl create nodegroup -f "$EKS_CONFIG" --include=faig-ng --profile "$AWS_PROFILE" --timeout 60m > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Creating CPU Node Group (faig-ng) failed"
      exit
    fi
    
    # Waiting for CPU node group to become ACTIVE...
    aws eks wait nodegroup-active --cluster-name "$EKS_CLUSTER_NAME" --nodegroup-name faig-ng --region "$EKS_REGION" \
        --profile "$AWS_PROFILE" || exit 1
    
    echo " ▪ Create GPU Node Group (gpu-ondemand-ng)"
    eksctl create nodegroup -f "$EKS_CONFIG" --include=gpu-ondemand-ng --profile "$AWS_PROFILE" --timeout 60m > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Creating GPU Node Group (gpu-ondemand-ng) failed"
      exit
    fi

    # Waiting for GPU node group to become ACTIVE...
    aws eks wait nodegroup-active --cluster-name "$EKS_CLUSTER_NAME" --nodegroup-name gpu-ondemand-ng --region "$EKS_REGION" \
        --profile "$AWS_PROFILE" || exit 1

    echo " ▪ EKS Cluster '$EKS_CLUSTER_NAME' successfully deployed"

    echo " ▪ Update Kubeconfig for the EKS Cluster"
    aws eks update-kubeconfig --name $EKS_CLUSTER_NAME --region "$EKS_REGION" > /dev/null 2>&1

    echo " ▪ Kubernetes Nodes Status"
    echo "   ------------------------------------------------------------------------------------------------------------------------------------------------------"
    kubectl get nodes   -L eks.amazonaws.com/nodegroup   -L eks.amazonaws.com/capacityType   -L node.kubernetes.io/instance-type | sed 's/^/   /g'
    echo "   ------------------------------------------------------------------------------------------------------------------------------------------------------"
  else
    stt=$(aws eks describe-cluster --name $EKS_CLUSTER_NAME --region $EKS_REGION --query "cluster.status" --output text --no-cli-pager)
    if [ "$stt" == "ACTIVE" ]; then
      aws eks update-kubeconfig --name "$EKS_CLUSTER_NAME" --region "$EKS_REGION" >/tmp/error.log 2>&1 || return 1
      echo " ▪ EKS Cluster '$EKS_CLUSTER_NAME' already installed with status ($stt)"
      echo " ▪ Kubernetes Nodes Status"
      echo "   ------------------------------------------------------------------------------------------------------------------------------------------------------"
      kubectl get nodes   -L eks.amazonaws.com/nodegroup   -L eks.amazonaws.com/capacityType   -L node.kubernetes.io/instance-type | sed 's/^/   /g'
      echo "   ------------------------------------------------------------------------------------------------------------------------------------------------------"
    else
      echo "ERROR: Cluster is currently in ($stt) state. Please fix or remove the cluster to proceede"
      exit
    fi

  fi

}

# ------------------------------------------------------------------------------------------
# Function Name ......: installNodeGroup
# Function Purpose ...: Install the EKS NoadeGroup gpu-ondemand-ng or gpu-spot-ng
# ------------------------------------------------------------------------------------------
# Argument ($1) ......:
# Dependancies: ......: AWS_REGION, EKS_CLUSTER_NAME
# ------------------------------------------------------------------------------------------
# Return Value .......: 0 - Success, 1 - failed
# ------------------------------------------------------------------------------------------
installNodeGroup() {
  # 8–10 Very likely to succeed
  # 5–7 Might work
  # 1–4 High chance of failure
  spotscore=$(verifySpotPlacementScrores $AWS_REGION)

  if [ $spotscore -lt 3 ]; then
    export EKS_NODEGROUP_TYPE=gpu-ondemand-ng
    echo " ▪ To few gpu-spot-ng availability zones in Region: $AWS_REGION, deployeing gpu-ondemand-ng instead"
  else
    export EKS_NODEGROUP_TYPE=gpu-spot-ng
    echo " ▪ Trying to go with gpu-ondemand-ng NodeGroups"
  fi

  echo " ▪  Write EKS configuration to state file (\$HOME/.faig/deploy.stat)"
  echo "export EKS_NODEGROUP_TYPE=$EKS_NODEGROUP_TYPE"   >> $HOME/.faig/deploy.stat

  nodegroups=$(aws eks list-nodegroups  --cluster-name $EKS_CLUSTER_NAME --region $AWS_REGION  --no-cli-pager | jq -r '.nodegroups[]')
  if [ "$nodegroups" == "" ]; then
    echo " ▪ Creating EKS NodeGroup type $EKS_NODEGROUP_TYPE"
    sed -e "s/CLUSTER/$EKS_CLUSTER_NAME/g" \
        -e "s/REGION/$AWS_REGION/g"  \
        -e "s/REGION/$AWS_REGION/g"  \
        -e "s/REGION/$AWS_REGION/g"  \
        files/${EKS_NODEGROUP_TYPE}-template.yaml > /tmp/${EKS_NODEGROUP_TYPE}.yaml
    eksctl create nodegroup --config-file /tmp/${EKS_NODEGROUP_TYPE}.yaml --profile "$AWS_PROFILE" > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: NodeGroup creatation failed"
      echo "      => eksctl create nodegroup --config-file /tmp/${EKS_NODEGROUP_TYPE}.yaml"
      exit 1
    fi
  else
    echo " ▪ EKS NodeGroup for cluster '$EKS_CLUSTER_NAME' already installed"
  fi

  messageTitle " ▪ Update Kubeconfig for the EKS Cluster"
  aws eks update-kubeconfig --name $EKS_CLUSTER_NAME --region $AWS_REGION > /dev/null 2>&1
}

# ------------------------------------------------------------------------------------------
# Function Name ......: installALBloadBalancer
# Function Purpose ...: Install the ALB Load Balancer
# ------------------------------------------------------------------------------------------
# Argument ($1) ......:
# Dependancies: ......: AWS_REGION, EKS_CLUSTER_NAME
# ------------------------------------------------------------------------------------------
# Return Value .......: 0 - Success, 1 - failed
# ------------------------------------------------------------------------------------------
installALBloadBalancer() {

  SA_NAMESPACE="kube-system"
  POLICY_NAME="AWSLoadBalancerControllerIAMPolicy"
  ROLE_NAME="AmazonEKSLoadBalancerControllerRole-${EKS_REGION}"

  messageTitle "ALB Load Balancer for EKS Kubernetes Cluster"

  # Get AWS Account ID from current login/session
  AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --profile "$AWS_PROFILE" --output text 2>/tmp/error.log); ret=$?
  if [ $ret -ne 0 -o -z "$AWS_ACCOUNT_ID" ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to get AWS Account ID from current login"
    echo "       => aws sts get-caller-identity --query Account --output text"
    exit 1
  fi

  kubectl -n "$SA_NAMESPACE" get deployment aws-load-balancer-controller >/dev/null 2>&1; ret=$?
  if [ $ret -ne 0 ]; then
    echo " ▪ install the ALB Load Balancer"
    echo " ▪ AWS Account ID .......: $AWS_ACCOUNT_ID"

    # Ensure the IAM OIDC provider exists
    eksctl utils associate-iam-oidc-provider \
      --cluster "$EKS_CLUSTER_NAME" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --approve > /tmp/error.log 2>&1; ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: ALB Load Balancer creation failed"
      echo "       => eksctl utils associate-iam-oidc-provider --cluster $EKS_CLUSTER_NAME --region $EKS_REGION --approve"
      exit 1
    fi

    # Ensure the IAM policy exists
    aws iam get-policy --profile "$AWS_PROFILE" \
      --policy-arn "arn:aws:iam::$AWS_ACCOUNT_ID:policy/$POLICY_NAME" >/dev/null 2>&1; ret=$?

    if [ $ret -ne 0 ]; then
      echo " ▪ create IAM policy $POLICY_NAME"

      curl -fsSL -o /tmp/iam_policy.json \
        https://raw.githubusercontent.com/kubernetes-sigs/aws-load-balancer-controller/main/docs/install/iam_policy.json \
        > /tmp/error.log 2>&1; ret=$?

      if [ $ret -ne 0 ]; then
        logMessages /tmp/error.log
        echo "ERROR: Downloading IAM policy failed"
        echo "       => curl -fsSL -o /tmp/iam_policy.json https://raw.githubusercontent.com/kubernetes-sigs/aws-load-balancer-controller/main/docs/install/iam_policy.json"
        exit 1
      fi

      aws iam create-policy \
        --policy-name "$POLICY_NAME" \
        --profile "$AWS_PROFILE" \
        --policy-document file:///tmp/iam_policy.json > /tmp/error.log 2>&1; ret=$?

      if [ $ret -ne 0 ]; then
        logMessages /tmp/error.log
        echo "ERROR: Install IAM Policy failed"
        echo "       => aws iam create-policy --policy-name $POLICY_NAME --policy-document file:///tmp/iam_policy.json"
        exit 1
      fi
    else
      echo " ▪ IAM policy already exists"
    fi

    # Create or update the IAM service account
    echo " ▪ create IAM service account aws-load-balancer-controller"
    eksctl create iamserviceaccount \
      --cluster "$EKS_CLUSTER_NAME" \
      --region "$EKS_REGION" \
      --namespace "$SA_NAMESPACE" \
      --name aws-load-balancer-controller \
      --profile "$AWS_PROFILE" \
      --role-name "$ROLE_NAME" \
      --attach-policy-arn "arn:aws:iam::$AWS_ACCOUNT_ID:policy/$POLICY_NAME" \
      --override-existing-serviceaccounts \
      --approve > /tmp/error.log 2>&1; ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Creating Service Account failed"
      echo "       => eksctl create iamserviceaccount \\"
      echo "            --cluster $EKS_CLUSTER_NAME \\"
      echo "            --region $EKS_REGION \\"
      echo "            --namespace $SA_NAMESPACE \\"
      echo "            --name aws-load-balancer-controller \\"
      echo "            --role-name $ROLE_NAME \\"
      echo "            --attach-policy-arn arn:aws:iam::$AWS_ACCOUNT_ID:policy/$POLICY_NAME \\"
      echo "            --override-existing-serviceaccounts \\"
      echo "            --approve"
      exit 1
    fi

    echo " ▪ Add Helm Repo https://aws.github.io/eks-charts"
    helm repo add eks https://aws.github.io/eks-charts >/dev/null 2>&1 || true

    helm repo update > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Helm repo update failed"
      echo "       => helm repo update"
      exit 1
    fi

    VPC_ID=$(aws eks describe-cluster \
      --name "$EKS_CLUSTER_NAME" \
      --profile "$AWS_PROFILE" \
      --region "$EKS_REGION" \
      --query 'cluster.resourcesVpcConfig.vpcId' \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 -o -z "$VPC_ID" ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to get VPC ID for cluster $EKS_CLUSTER_NAME"
      echo "       => aws eks describe-cluster --name $EKS_CLUSTER_NAME --region $EKS_REGION --query 'cluster.resourcesVpcConfig.vpcId' --output text"
      exit 1
    fi

    echo " ▪ Installing/upgrading AWS Load Balancer Controller..."
    helm upgrade --install aws-load-balancer-controller eks/aws-load-balancer-controller \
      -n "$SA_NAMESPACE" \
      --set clusterName="$EKS_CLUSTER_NAME" \
      --set serviceAccount.create=false \
      --set serviceAccount.name=aws-load-balancer-controller \
      --set region="$EKS_REGION" \
      --set vpcId="$VPC_ID" > /tmp/error.log 2>&1; ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Helm installation of AWS Load Balancer Controller failed"
      echo "       => helm upgrade --install aws-load-balancer-controller eks/aws-load-balancer-controller -n $SA_NAMESPACE ..."
      exit 1
    fi

    echo " ▪ Waiting for deployment to become ready..."
    kubectl -n "$SA_NAMESPACE" rollout status deployment/aws-load-balancer-controller --timeout=5m > /tmp/error.log 2>&1; ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: AWS Load Balancer Controller deployment did not become ready"
      echo "       => kubectl -n $SA_NAMESPACE rollout status deployment/aws-load-balancer-controller --timeout=5m"
      exit 1
    fi
  else
    echo " ▪ ALB Load Balancer already installed"
    #kubectl -n "$SA_NAMESPACE" get deployment aws-load-balancer-controller
  fi
}

# ------------------------------------------------------------------------------------------
# Function Name ......: updateAppDNS
# Function Purpose ...: Update Route53 DNS record for the ALB Ingress hostname
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: <namespace>
# Argument ($2) ......: <app-name>
# Argument ($3) ......: <fqdn>
# Argument ($4) ......: <hosted-zone-id>
# Dependancies: ......: kubectl
# ------------------------------------------------------------------------------------------
# Return Value .......: none (exit on error)
# ------------------------------------------------------------------------------------------
updateAppDNS() {
  [ "${ROUTE53_DNS_UPDATES:-true}" == "false" ] && return 0

  local APP_NAMESPACE="$1" APP_NAME="$2" APP_FQDN="$3" HOSTED_ZONE_ID="$4"
  local APP_INGRESS="${2}-ingress"
  local ALB_HOSTNAME="" OLD_DNS_TARGET="" CHANGE_ID="" records change_batch
  local ret n STATUS FINAL_DNS_TARGET RESOLVED_8 RESOLVED_1 MATCH_8 MATCH_1

  if [ -z "$APP_NAMESPACE" ] || [ -z "$APP_NAME" ] || [ -z "$APP_FQDN" ] || [ -z "$HOSTED_ZONE_ID" ]; then
    echo "ERROR: updateAppDNS requires namespace, app name, FQDN and hosted zone ID"
    return 1
  fi

  # Wait for provisioning, but do not hide API failures or wait forever.
  for ((n=0; n<60; n++)); do

    ALB_HOSTNAME=$(kubectl -n "$APP_NAMESPACE" get ingress "$APP_INGRESS" \
      -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/tmp/error.log) || {
      logMessages /tmp/error.log
      return 1
    }
    [ -n "$ALB_HOSTNAME" ] && break
    sleep 15
  done
  if [ -z "$ALB_HOSTNAME" ]; then
    echo "ERROR: Timed out waiting for $APP_NAMESPACE/$APP_INGRESS load balancer"
    return 1
  fi

  # Compare authoritative state, not cached public DNS resolution.
  records=$(aws route53 list-resource-record-sets \
    --hosted-zone-id "$HOSTED_ZONE_ID" --profile "$AWS_PROFILE" \
    --output json --no-cli-pager 2>/tmp/error.log) || {
    logMessages /tmp/error.log
    return 1
  }
  OLD_DNS_TARGET=$(printf '%s' "$records" | jq -er --arg name "${APP_FQDN%.}." '
    [.ResourceRecordSets[] | select(.Name == $name and .Type == "CNAME")
      | .ResourceRecords[0].Value][0] // ""') || return 1
  if [ "${OLD_DNS_TARGET%.}" = "${ALB_HOSTNAME%.}" ]; then
    echo " ▪ DNS already configured: $APP_FQDN -> $ALB_HOSTNAME"
    return 0
  fi

  change_batch=$(jq -n --arg name "$APP_FQDN" --arg target "$ALB_HOSTNAME" '
    {Changes: [{Action: "UPSERT", ResourceRecordSet: {
      Name: $name, Type: "CNAME", TTL: 300, ResourceRecords: [{Value: $target}]
    }}]}') || return 1
  CHANGE_ID=$(aws route53 change-resource-record-sets \
    --hosted-zone-id "$HOSTED_ZONE_ID" --profile "$AWS_PROFILE" \
    --change-batch "$change_batch" --query 'ChangeInfo.Id' \
    --output text 2>/tmp/error.log) || {
    logMessages /tmp/error.log
    return 1
  }
  if [ -z "$CHANGE_ID" ] || [ "$CHANGE_ID" = None ]; then
    echo "ERROR: Route53 did not return a change ID"
    return 1
  fi

  echo " ▪ Route53 Change ID ...: $CHANGE_ID"

echo hallo5
  # --------------------------------------------------------------------------
  # Wait for Route53 to become INSYNC
  # --------------------------------------------------------------------------
  echo " ▪ Waiting for Route53 change to become INSYNC..."

  n=0
  while [ $n -lt 60 ]; do
    STATUS=$(aws route53 get-change \
      --id "$CHANGE_ID" --profile "$AWS_PROFILE" \
      --query 'ChangeInfo.Status' \
      --output text 2>/tmp/error.log); ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to get Route53 change status"
      echo "       => aws route53 get-change --id $CHANGE_ID"
      return 1
    fi

    echo " ▪ Route53 Status ......: $STATUS"
    [ "$STATUS" = "INSYNC" ] && break

    sleep 5
    let n=n+1
  done

  if [ "$STATUS" != "INSYNC" ]; then
    echo "ERROR: Route53 change did not become INSYNC"
    echo "       Change ID .......: $CHANGE_ID"
    return 1
  fi

  # --------------------------------------------------------------------------
  # Re-read Route53 record and confirm it now matches the ALB hostname
  # --------------------------------------------------------------------------
  FINAL_DNS_TARGET=$(aws route53 list-resource-record-sets \
    --hosted-zone-id "$HOSTED_ZONE_ID" --profile "$AWS_PROFILE" \
    --query "ResourceRecordSets[?Name == '${APP_FQDN}.'].ResourceRecords[0].Value" \
    --output text 2>/tmp/error.log); ret=$?

  if [ $ret -ne 0 -o -z "$FINAL_DNS_TARGET" -o "$FINAL_DNS_TARGET" = "None" ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to verify final Route53 DNS record"
    echo "       => aws route53 list-resource-record-sets --hosted-zone-id $HOSTED_ZONE_ID"
    return 1
  fi

  echo " ▪ FINAL_DNS_TARGET ....: $FINAL_DNS_TARGET"

  if [ "$FINAL_DNS_TARGET" != "$ALB_HOSTNAME" ]; then
    echo "ERROR: Route53 record does not match current ALB hostname"
    echo "       Expected ........: $ALB_HOSTNAME"
    echo "       Found ...........: $FINAL_DNS_TARGET"
    return 1
  fi

  # --------------------------------------------------------------------------
  # Wait until DNS resolves publicly
  # --------------------------------------------------------------------------
  echo " ▪ Waiting for public DNS propagation..."

  RESOLVED_8=""
  RESOLVED_1=""

  n=0
  while [ $n -lt 30 ]; do
    RESOLVED_8=$(dig +short "$APP_FQDN" @8.8.8.8 | head -1)
    RESOLVED_1=$(dig +short "$APP_FQDN" @1.1.1.1 | head -1)

    echo " ▪ Public DNS (8.8.8.8) : $RESOLVED_8"
    echo " ▪ Public DNS (1.1.1.1) : $RESOLVED_1"

    if [ "$RESOLVED_8" = "$ALB_HOSTNAME." -o "$RESOLVED_8" = "$ALB_HOSTNAME" ]; then
      if [ "$RESOLVED_1" = "$ALB_HOSTNAME." -o "$RESOLVED_1" = "$ALB_HOSTNAME" ]; then
        break
      fi
    fi

    sleep 5
    let n=n+1
  done

  MATCH_8=0
  MATCH_1=0
  [ "$RESOLVED_8" = "$ALB_HOSTNAME." -o "$RESOLVED_8" = "$ALB_HOSTNAME" ] && MATCH_8=1
  [ "$RESOLVED_1" = "$ALB_HOSTNAME." -o "$RESOLVED_1" = "$ALB_HOSTNAME" ] && MATCH_1=1

  if [ $MATCH_8 -ne 1 -o $MATCH_1 -ne 1 ]; then
    echo " ▪ Route53 is configured; public DNS caches have not refreshed yet"
    echo "       FQDN ............: $APP_FQDN"
    echo "       Expected ........: $ALB_HOSTNAME"
    echo "       8.8.8.8 .........: $RESOLVED_8"
    echo "       1.1.1.1 .........: $RESOLVED_1"
    return 0
  fi

  echo " ▪ DNS record successfully propagated"
  echo " ▪ Application DNS ready: $APP_FQDN -> $ALB_HOSTNAME"
}

# ------------------------------------------------------------------------------------------
# Function Name ......: deployApp
# Function Purpose ...: Deploy an application workload
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: <app-name>
# Dependancies: ......:
# ------------------------------------------------------------------------------------------
# Return Value .......:
# ------------------------------------------------------------------------------------------
deployApp() {

  APP_NAME="$1"
  APP_NAMESPACE="$APP_NAME"
  APP_DEPLOYMENT="$APP_NAME"

  messageTitle "Deploy Application $APP_NAME"

  if [ -z "$APP_NAME" ]; then
    echo "ERROR: Missing arguments"
    echo "       => deployApp <app-name>"
    exit 1
  fi

  kubectl get namespace "$APP_NAMESPACE" >/dev/null 2>&1; ret=$?
  if [ $ret -ne 0 ]; then
    echo " ▪ Create Namespace ....: $APP_NAMESPACE"
    kubectl create namespace "$APP_NAMESPACE" > /tmp/error.log 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Creating namespace failed"
      echo "       => kubectl create namespace $APP_NAMESPACE"
      exit 1
    fi
  else
    echo " ▪ Namespace already exists"
  fi

  if [ ! -f "files/${APP_NAME}.yaml" ]; then
    echo "ERROR: Application manifest not found"
    echo "       => files/${APP_NAME}.yaml"
    exit 1
  fi

  echo " ▪ Apply App Manifest ..: files/${APP_NAME}.yaml"
  kubectl apply -n "$APP_NAMESPACE" -f "files/${APP_NAME}.yaml" > /tmp/error.log 2>&1; ret=$?
  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Deploying application failed"
    echo "       => kubectl apply -n $APP_NAMESPACE -f files/${APP_NAME}.yaml"
    exit 1
  fi

  echo " ▪ Waiting for Deployment to become ready..."
  kubectl -n "$APP_NAMESPACE" rollout status deployment/"$APP_DEPLOYMENT" --timeout=5m > /tmp/error.log 2>&1; ret=$?
  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Application deployment did not become ready"
    echo "       => kubectl -n $APP_NAMESPACE rollout status deployment/$APP_DEPLOYMENT --timeout=5m"
    exit 1
  fi
}

# ------------------------------------------------------------------------------------------
# Function Name ......: requestACMcertificate
# Function Purpose ...: Issue ACM Certificate
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: <route53-hosted-zone-id>
# Dependancies: ......: AWS_REGION, EKS_CLUSTER_NAME
# ------------------------------------------------------------------------------------------
# Return Value .......: Sets CERT_ARN
# ------------------------------------------------------------------------------------------
requestACMcertificate() {

  [ "${ROUTE53_DNS_UPDATES:-true}" == "false" ] && return 0

  local HOSTED_ZONE_ID="$1"
  local ALB_REGION="$EKS_REGION"
  local CERT_DOMAIN="*.$ROUTE53_DOMAIN"
  local CERT_SAN="$ROUTE53_DOMAIN"
  local CERT_SAN_FOUND=""
  local CERT_STATUS=""
  local VALIDATION_NAME=""
  local VALIDATION_VALUE=""
  local VALIDATION_RECORDS=""
  local CERT_LIST=""
  local CERT_DETAILS=""
  local CHANGE_BATCH=""
  local ret=0
  local n=0

  messageTitle "Ingress Certificate for ALB Load Balancer"

  if [ -z "$HOSTED_ZONE_ID" ] || [ -z "$ALB_REGION" ] || \
     [ -z "$ROUTE53_DOMAIN" ] || [ -z "$AWS_PROFILE" ]; then
    echo "ERROR: Missing ACM certificate configuration"
    return 1
  fi

  # ----------------------------------------------------------------------------------------
  # Check if we already have a valid ISSUED certificate
  # ----------------------------------------------------------------------------------------
  CERT_LIST=$(aws acm list-certificates \
    --region "$ALB_REGION" \
    --certificate-statuses ISSUED \
    --profile "$AWS_PROFILE" \
    --output json 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Failed to check existing ACM certificates"
    return 1
  fi

  CERT_ARN=""

  # Check all matching certificates until one with the required SAN is found.
  while IFS= read -r CANDIDATE_ARN; do

    [ -z "$CANDIDATE_ARN" ] && continue

    CERT_DETAILS=$(aws acm describe-certificate \
      --certificate-arn "$CANDIDATE_ARN" \
      --region "$ALB_REGION" \
      --profile "$AWS_PROFILE" \
      --output json 2>/tmp/error.log)
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to validate existing ACM certificate"
      return 1
    fi

    CERT_SAN_FOUND=$(printf '%s' "$CERT_DETAILS" | jq -r \
      --arg san "$CERT_SAN" \
      'if (.Certificate.SubjectAlternativeNames // [] | index($san)) != null
       then "yes" else "no" end')

    if [ "$CERT_SAN_FOUND" = "yes" ]; then
      CERT_ARN="$CANDIDATE_ARN"
      break
    fi

  done < <(printf '%s' "$CERT_LIST" | jq -r --arg domain "$CERT_DOMAIN" '
    .CertificateSummaryList[]
    | select(.DomainName == $domain)
    | .CertificateArn
  ')

  if [ -n "$CERT_ARN" ]; then
    echo " ▪ Valid ACM certificate already exists"
    echo " ▪ CERT_ARN ............: $CERT_ARN"
    return 0
  fi

  # ----------------------------------------------------------------------------------------
  # Request new certificate if none exists
  # ----------------------------------------------------------------------------------------
  echo " ▪ Request new ACM certificate in $ALB_REGION"

  CERT_ARN=$(aws acm request-certificate \
    --domain-name "$CERT_DOMAIN" \
    --subject-alternative-names "$CERT_SAN" \
    --validation-method DNS \
    --profile "$AWS_PROFILE" \
    --region "$ALB_REGION" \
    --query 'CertificateArn' \
    --output text 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ] || [ -z "$CERT_ARN" ] || [ "$CERT_ARN" = "None" ]; then
    logMessages /tmp/error.log
    echo "ERROR: Requesting ACM certificate failed"
    return 1
  fi

  echo " ▪ CERT_ARN ............: $CERT_ARN"

  # ----------------------------------------------------------------------------------------
  # Wait until ACM provides the DNS validation record
  # ----------------------------------------------------------------------------------------
  echo " ▪ Waiting for ACM validation records..."

  for ((n=0; n<30; n++)); do

    VALIDATION_RECORDS=$(aws acm describe-certificate \
      --certificate-arn "$CERT_ARN" \
      --region "$ALB_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'Certificate.DomainValidationOptions[].ResourceRecord' \
      --output json 2>/tmp/error.log)
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to read ACM validation records"
      return 1
    fi

    read -r VALIDATION_NAME VALIDATION_VALUE <<< \
      "$(printf '%s' "$VALIDATION_RECORDS" | jq -r '
        map(select(.Name != null and .Value != null))
        | unique_by(.Name, .Value)
        | .[0] // {}
        | "\(.Name // "") \(.Value // "")"
      ')"

    if [ -n "$VALIDATION_NAME" ] && [ -n "$VALIDATION_VALUE" ]; then
      break
    fi

    sleep 5
  done

  if [ -z "$VALIDATION_NAME" ] || [ -z "$VALIDATION_VALUE" ]; then
    echo "ERROR: Timed out waiting for ACM validation records"
    return 1
  fi

  echo " ▪ VALIDATION_NAME .....: $VALIDATION_NAME"
  echo " ▪ VALIDATION_VALUE ....: $VALIDATION_VALUE"

  # ----------------------------------------------------------------------------------------
  # Create / update Route53 validation CNAME
  # ----------------------------------------------------------------------------------------
  CHANGE_BATCH=$(jq -n \
    --arg name "$VALIDATION_NAME" \
    --arg value "$VALIDATION_VALUE" '
    {
      Changes: [{
        Action: "UPSERT",
        ResourceRecordSet: {
          Name: $name,
          Type: "CNAME",
          TTL: 300,
          ResourceRecords: [{Value: $value}]
        }
      }]
    }
  ')

  echo " ▪ Create/Update Route53 validation CNAME"

  aws route53 change-resource-record-sets \
    --hosted-zone-id "$HOSTED_ZONE_ID" \
    --profile "$AWS_PROFILE" \
    --change-batch "$CHANGE_BATCH" \
    > /tmp/error.log 2>&1
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log
    echo "ERROR: Creating Route53 validation CNAME failed"
    return 1
  fi

  # ----------------------------------------------------------------------------------------
  # Wait until certificate becomes ISSUED
  # ----------------------------------------------------------------------------------------
  echo " ▪ Waiting for certificate to become ISSUED..."

  for ((n=0; n<120; n++)); do

    CERT_STATUS=$(aws acm describe-certificate \
      --certificate-arn "$CERT_ARN" \
      --region "$ALB_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'Certificate.Status' \
      --output text 2>/tmp/error.log)
    ret=$?

    if [ $ret -ne 0 ]; then
      logMessages /tmp/error.log
      echo "ERROR: Failed to read ACM certificate status"
      return 1
    fi

    echo " ▪ Certificate Status ..: $CERT_STATUS"

    if [ "$CERT_STATUS" = "ISSUED" ]; then
      echo " ▪ Ingress certificate installed successfully"
      echo " ▪ CERT_ARN ............: $CERT_ARN"
      return 0
    fi

    if [ "$CERT_STATUS" = "FAILED" ] || \
       [ "$CERT_STATUS" = "VALIDATION_TIMED_OUT" ] || \
       [ "$CERT_STATUS" = "REVOKED" ]; then
      echo "ERROR: ACM certificate request failed ($CERT_STATUS)"
      return 1
    fi

    sleep 10
  done

  echo "ERROR: Timed out waiting for ACM certificate issuance"
  return 1
}

# ------------------------------------------------------------------------------------------
# Function Name ......: getCertARN
# Function Purpose ...: Return ARN of an existing ACM certificate
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: domain
# Dependancies: ......: AWS_REGION
# ------------------------------------------------------------------------------------------
# Return Value .......: prints CERT_ARN to stdout
# ------------------------------------------------------------------------------------------
getCertARN() {
  local DOMAIN="$1"
  local CERT_LIST=""
  local ret=0

  if [ -z "$DOMAIN" ]; then
    echo "ERROR: getCertARN requires a domain" >&2
    return 1
  fi

  CERT_LIST=$(aws acm list-certificates \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --certificate-statuses ISSUED \
    --output json 2>/tmp/error.log)
  ret=$?

  if [ $ret -ne 0 ]; then
    logMessages /tmp/error.log >&2
    echo "ERROR: Failed to list ACM certificates in $EKS_REGION" >&2
    return 1
  fi

  printf '%s\n' "$CERT_LIST" | jq -r --arg domain "$DOMAIN" '
    .CertificateSummaryList
    | map(select(.DomainName == $domain))
    | .[0].CertificateArn // empty
  '
}

