deleteClassicLoadBalancersInVpc() {
  vpcId="$1"

  aws elb describe-load-balancers --profile "$AWS_PROFILE" \
    --region $EKS_REGION > /tmp/elbs.json 2>/dev/null

  for lb in $(jq -r --arg vpc "$vpcId" '.LoadBalancerDescriptions[]? | select(.VPCId == $vpc) | .LoadBalancerName' /tmp/elbs.json); do
    echo "Delete Classic Load Balancer: $lb"
    aws elb delete-load-balancer \
      --load-balancer-name "$lb" \
      --region $AWS_REGION > /tmp/error.log 2>&1; ret=$?
    [ $ret -ne 0 ] && logMessages /tmp/error.log
  done
}

# ------------------------------------------------------------------------------------------
# Function Name ......: waitForNamespaceDeletion
# Function Purpose ...: Wait for EKS Cluster to be deleted
# ------------------------------------------------------------------------------------------
# Dependencies .......: EFS_FILE_SYSTEM_ID, EFS_STORAGE_CLASS
# Optional Vars ......: EFS_MODE=[shared|faig]
# ------------------------------------------------------------------------------------------
waitForNamespaceDeletion() {
  local ns="$1"
  local timeout="${2:-600}"   # default 10 minutes
  local interval=10
  local elapsed=0

  while true; do
    if ! kubectl get ns "$ns" >/dev/null 2>&1; then
      return 0
    fi

    local phase
    phase=$(kubectl get ns "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || echo "unknown")

    if [ "$elapsed" -ge "$timeout" ]; then
      return 1
    fi

    sleep "$interval"
    elapsed=$((elapsed + interval))
  done
}

# ------------------------------------------------------------------------------------------
# Function Name ......: deleteNamespace
# Function Purpose ...: Delete a Kubernetes Namespace
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: Namespace
# ------------------------------------------------------------------------------------------
# Return Value .......: 0 - Success, 1 - Failed
# ------------------------------------------------------------------------------------------
deleteNamespace() {
  NAMESPACE=$1
  
  [ "$NAMESPACE" == "default" ] && return

  nam=$NAMESPACE
  while [ "$nam" == "$NAMESPACE" ]; do
    kubectl get ns -o json > /tmp/output.json
    if [ -s /tmp/output.json ]; then
      nam=$(jq -r --arg key "$NAMESPACE" '.items[] | select(.metadata.name == $key).metadata.name' /tmp/output.json)
  
      if [ "$nam" != "" ]; then
        _stt=$(jq -r --arg key "$NAMESPACE" '.items[] | select(.metadata.name == $key).status.phase' /tmp/output.json)
        if [ "$_stt" == "Terminating" ]; then
          kubectl get ns $NAMESPACE -o json | \
                  jq -r '. | select(.spec.finalizers[] == "kubernetes").spec.finalizers |= []' > /tmp/namespace.json
          kubectl replace --raw "/api/v1/namespaces/$NAMESPACE/finalize" -f /tmp/namespace.json > /dev/null 2>&1
        else    
          kubectl delete ns $NAMESPACE > /tmp/error.log 2>&1; ret=$?
        fi
      fi
    fi
  
    sleep 10
  done
}

# ------------------------------------------------------------------------------------------
# Function Name ......: deleteHelmChart
# Function Purpose ...: Delete a Helm Chart
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: Namespace
#          ($2) ......: Helm Chart
# ------------------------------------------------------------------------------------------
# Return Value .......: 0 - Success, 1 - Failed
# ------------------------------------------------------------------------------------------
deleteHelmChart() {
  NAMESPACE=$1
  HELMCHART=$2

  helm list -A -o json > /tmp/output.json
  if [ -s /tmp/output.json ]; then
    nam=$(jq -r --arg ns "$NAMESPACE" --arg chart "$HELMCHART" '.[] | select(.namespace == $ns and .name == $chart).name' /tmp/output.json)

    if [ "$nam" != "" ]; then
      helm uninstall -n $NAMESPACE $HELMCHART > /tmp/error.log 2>&1; ret=$?

      if [ $ret -ne 0 ]; then
        logMessages /tmp/error.log
        echo "ERROR: Deleting Helm Chart $HELMCHART"
        echo "       => helm uninstall -n $NAMESPACE $HELMCHART"
        exit 1
      fi
    fi
  fi
}

# ------------------------------------------------------------------------------------------
# Function Name ......: cleanupEksDeployment
# Function Purpose ...: Delete EKS deployment and Capacity Reservation
# ------------------------------------------------------------------------------------------
cleanupEksDeployment() {

  local reservation_state
  local cluster_state
  local result
  local rc
  local nodegroup

  echo "Delete EKS Deployment"
  echo " ▪ Cluster: $EKS_CLUSTER_NAME"
  echo " ▪ Region: $EKS_REGION"

  read -r -p "Type DELETE to confirm: " CONFIRM

  if [ "$CONFIRM" != "DELETE" ]; then
    echo " ▪ Cleanup cancelled"
    return 1
  fi

  # ----------------------------------------------------------------------------------------
  # Delete EKS Node Groups
  # ----------------------------------------------------------------------------------------
  for nodegroup in gpu-ondemand-ng faig-ng; do

    echo " ▪ Delete Node Group ($nodegroup)"

    result=$(aws eks describe-nodegroup \
      --cluster-name "$EKS_CLUSTER_NAME" \
      --nodegroup-name "$nodegroup" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'nodegroup.status' \
      --output text 2>&1)
    rc=$?

    if [ "$rc" -ne 0 ]; then
      if [[ "$result" == *ResourceNotFoundException* ]]; then
        continue
      fi

      echo "ERROR: $result"
      return 1
    fi

    if ! eksctl delete nodegroup \
      --cluster "$EKS_CLUSTER_NAME" \
      --name "$nodegroup" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --disable-eviction \
      --wait; then

      echo "ERROR: Failed to delete Node Group ($nodegroup)"
      return 1
    fi

    if ! aws eks wait nodegroup-deleted \
      --cluster-name "$EKS_CLUSTER_NAME" \
      --nodegroup-name "$nodegroup" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE"; then

      echo "ERROR: Node Group deletion not confirmed ($nodegroup)"
      return 1
    fi

  done

  # ----------------------------------------------------------------------------------------
  # Delete EKS Cluster
  # ----------------------------------------------------------------------------------------
  echo " ▪ Delete EKS Cluster ($EKS_CLUSTER_NAME)"

  result=$(aws eks describe-cluster \
    --name "$EKS_CLUSTER_NAME" \
    --region "$EKS_REGION" \
    --profile "$AWS_PROFILE" \
    --query 'cluster.status' \
    --output text 2>&1)
  rc=$?

  if [ "$rc" -ne 0 ]; then
    if [[ "$result" != *ResourceNotFoundException* ]]; then
      echo "ERROR: $result"
      return 1
    fi
  else

    if ! eksctl delete cluster \
      --name "$EKS_CLUSTER_NAME" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --wait; then

      echo "ERROR: Failed to delete EKS Cluster"
      return 1
    fi

    if ! aws eks wait cluster-deleted \
      --name "$EKS_CLUSTER_NAME" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE"; then

      echo "ERROR: EKS Cluster deletion not confirmed"
      return 1
    fi
  fi

  # ----------------------------------------------------------------------------------------
  # Delete Capacity Reservation
  # ----------------------------------------------------------------------------------------
  if [ -n "${reservation_id:-${RESERVATION_ID:-}}" ]; then

    reservation_id="${reservation_id:-$RESERVATION_ID}"

    echo " ▪ Cancel Capacity Reservation ($reservation_id)"

    result=$(aws ec2 describe-capacity-reservations \
      --capacity-reservation-ids "$reservation_id" \
      --region "$EKS_REGION" \
      --profile "$AWS_PROFILE" \
      --query 'CapacityReservations[0].State' \
      --output text 2>&1)
    rc=$?

    if [ "$rc" -ne 0 ]; then
      if [[ "$result" != *InvalidCapacityReservationId.NotFound* ]]; then
        echo "ERROR: $result"
        return 1
      fi

    elif [ "$result" = "cancelled" ] || [ "$result" = "expired" ]; then
      :

    elif [ "$result" = "active" ] || [ "$result" = "pending" ]; then

      if ! aws ec2 cancel-capacity-reservation \
        --capacity-reservation-id "$reservation_id" \
        --region "$EKS_REGION" \
        --profile "$AWS_PROFILE" >/dev/null; then

        echo "ERROR: Failed to cancel Capacity Reservation"
        return 1
      fi

      local attempts=0

      while true; do

        result=$(aws ec2 describe-capacity-reservations \
          --capacity-reservation-ids "$reservation_id" \
          --region "$EKS_REGION" \
          --profile "$AWS_PROFILE" \
          --query 'CapacityReservations[0].State' \
          --output text 2>&1)
        rc=$?

        if [ "$rc" -ne 0 ]; then
          if [[ "$result" == *InvalidCapacityReservationId.NotFound* ]]; then
            break
          fi

          echo "ERROR: $result"
          return 1
        fi

        if [ "$result" = "cancelled" ] || [ "$result" = "expired" ]; then
          break
        fi

        attempts=$((attempts + 1))

        if [ "$attempts" -ge 60 ]; then
          echo "ERROR: Capacity Reservation cancellation timed out"
          return 1
        fi

        sleep 5
      done

    else
      echo "ERROR: Unexpected Capacity Reservation state: $result"
      return 1
    fi

  else
    echo " ▪ No Capacity Reservation ID configured"
  fi

  echo " ▪ Remote Deployment Status file ($HOME/.faig/deploy.stat)"
  rm -f  $HOME/.faig/deploy.stat 

  echo " ▪ EKS Deployment cleanup completed successfully"

  return 0
}

# ------------------------------------------------------------------------------------------
# Function Name ......: checkEksNetworking
# Function Purpose ...: Check existing EKS networking and select the GPU reservation AZ
# ------------------------------------------------------------------------------------------
# Argument ($1) ......: EKS_REGION
# Argument ($2) ......: EKS_AZ
# Return Value .......: 0 on success, 1 on failure
# ------------------------------------------------------------------------------------------
checkEksNetworking() {
  local eks_region=$1
  local eks_az=$2
  local cluster_status

  cluster_status=$(aws eks describe-cluster \
    --name "$EKS_CLUSTER_NAME" \
    --region "$eks_region" \
    --profile "$AWS_PROFILE" \
    --query 'cluster.status' \
    --output text 2>/dev/null)

  if [ "$cluster_status" = "ACTIVE" ]; then
    echo " ▪ Existing EKS cluster found in $eks_region"
    echo " ▪ Existing cluster networking must be checked before adding GPU nodes"
    return 1
  fi

  echo " ▪ New EKS cluster: eksctl will create VPC and subnets"
  echo " ▪ GPU reservation availability zone: $eks_az"

  return 0
}
